<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The test classes share process-global singletons (AppConfig/AnnotationService/RoleService
       and the BROLEDGER_DATADIR env redirect) — collections must not run in parallel. -->
  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BroLedger.App\BroLedger.App.csproj" />
  </ItemGroup>

  <!-- Real-save fixture shared with Core.Tests (linked, not duplicated). The Export button
       nail parses it and asserts the CSV lands next to it. -->
  <ItemGroup>
    <Content Include="..\BroLedger.Core.Tests\TestData\TestSavefile.sav" Link="TestData\TestSavefile.sav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
