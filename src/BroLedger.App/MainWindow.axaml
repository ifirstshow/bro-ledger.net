<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BroLedger.App.MainWindow"
        Title="Bro Ledger" Width="1280" Height="800">
    <!-- Launch-check shell (task 2 builds the real chrome): keeper dark base + Cinzel title. -->
    <Border Classes="app-frame"
            Background="{StaticResource BgAppBrush}"
            TextElement.Foreground="{StaticResource GoldBrush}"
            TextElement.FontSize="13">
        <Border Classes="title-bar" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal">
                <TextBlock Classes="title-bar-label" Text="Bro Ledger" VerticalAlignment="Center"/>
                <TextBlock Classes="title-bar-version" Text="dev" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Border>
</Window>
