<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- keeper.css palette — the "variable segment". Avalonia has no :root selector, so the
         shared colors live here as resources; translated styles reference them by key.
         Values are ported verbatim from JAVARES css/keeper.css. -->
    <SolidColorBrush x:Key="BgAppBrush" Color="#1a1209" />
    <SolidColorBrush x:Key="BgTitleBarBrush" Color="#050302" />
    <SolidColorBrush x:Key="BgStatusBarBrush" Color="#0f0a04" />

    <SolidColorBrush x:Key="BorderAppBrush" Color="#2a1a08" />
    <SolidColorBrush x:Key="BorderTitleBarBrush" Color="#1a1005" />
    <SolidColorBrush x:Key="BorderStatusBarBrush" Color="#3a2510" />

    <SolidColorBrush x:Key="GoldBrush" Color="#d69f23" />
    <SolidColorBrush x:Key="VersionBrush" Color="#7a5c2a" />
    <SolidColorBrush x:Key="WindowBtnBrush" Color="#4a3820" />
    <SolidColorBrush x:Key="CloseHoverBgBrush" Color="#6b1515" />
    <SolidColorBrush x:Key="CloseHoverTextBrush" Color="#f0c0c0" />
    <SolidColorBrush x:Key="StatusTextBrush" Color="#8a7040" />
    <SolidColorBrush x:Key="WarningBrush" Color="#c87820" />

    <!-- Task 2 segments: toolbar / fancy buttons / leds / fields / section headers. -->
    <SolidColorBrush x:Key="BgToolbarBrush" Color="#0f0a04" />
    <SolidColorBrush x:Key="WatchStatusBrush" Color="#6a9a38" />
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="#ba9238" />

    <!-- .fancy-btn gradient (top/bottom) + border; hover lightens, pressed reverses. -->
    <SolidColorBrush x:Key="FancyBorderBrush" Color="#6a4a28" />
    <LinearGradientBrush x:Key="FancyBgBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#4a3018" Offset="0" />
        <GradientStop Color="#2d1d0c" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FancyBgHoverBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#5a3a20" Offset="0" />
        <GradientStop Color="#3a2510" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FancyBgPressedBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#2d1d0c" Offset="0" />
        <GradientStop Color="#4a3018" Offset="1" />
    </LinearGradientBrush>

    <!-- .btn-led colors; lit variants add the dropshadow glow in Base.axaml. -->
    <SolidColorBrush x:Key="LedRedBrush" Color="#8b2222" />
    <SolidColorBrush x:Key="LedGreenBrush" Color="#1e6b1e" />
    <SolidColorBrush x:Key="LedYellowBrush" Color="#7a6418" />
    <SolidColorBrush x:Key="LedRedLitBrush" Color="#e53935" />
    <SolidColorBrush x:Key="LedGreenLitBrush" Color="#43a047" />

    <!-- .text-field base (dark amber field look for every TextBox). -->
    <SolidColorBrush x:Key="FieldBgBrush" Color="#120d05" />
    <SolidColorBrush x:Key="FieldBorderBrush" Color="#3a2510" />
    <SolidColorBrush x:Key="FieldFocusBrush" Color="#ba9238" />
    <SolidColorBrush x:Key="FieldPlaceholderBrush" Color="#4a3820" />

    <!-- Cinzel regular + bold faces (keeper.css -fx-font-family: 'Cinzel'). -->
    <FontFamily x:Key="Cinzel">avares://BroLedger.App/Assets/Cinzel-Regular.otf#Cinzel,avares://BroLedger.App/Assets/Cinzel-Bold.otf#Cinzel</FontFamily>

    <!-- Task 3 segments: overview table (keeper.css overview/level/stat-cell/tier rules). -->
    <SolidColorBrush x:Key="BgOverviewHeaderBrush" Color="#0f0a04" />
    <SolidColorBrush x:Key="BgOverviewRowAltBrush" Color="#1d1309" />
    <SolidColorBrush x:Key="BgOverviewRowHoverBrush" Color="#2a1a08" />
    <SolidColorBrush x:Key="BgOverviewDragTargetBrush" Color="#3d2a0e" />
    <SolidColorBrush x:Key="BorderOverviewCellBrush" Color="#241608" />
    <SolidColorBrush x:Key="BorderFrontlineDividerBrush" Color="#ba9238" />
    <SolidColorBrush x:Key="StatValBrush" Color="#d69f23" />
    <SolidColorBrush x:Key="PotentialValBrush" Color="#ba9238" />
    <SolidColorBrush x:Key="ExpectedValBrush" Color="#78c87a" />
    <SolidColorBrush x:Key="StarEmptyBrush" Color="#3a2510" />
    <SolidColorBrush x:Key="AllottedBrush" Color="#888888" />
    <SolidColorBrush x:Key="AllottedGreenBrush" Color="#78c87a" />
    <SolidColorBrush x:Key="AllottedRedBrush" Color="#e07070" />
    <SolidColorBrush x:Key="PendingBadgeBrush" Color="#78c87a" />
    <SolidColorBrush x:Key="StatCellP1Brush" Color="#3c2712" />
    <SolidColorBrush x:Key="StatCellP2Brush" Color="#2d1c0b" />
    <SolidColorBrush x:Key="Tier1Brush" Color="#4ea84e" />
    <SolidColorBrush x:Key="Tier2Brush" Color="#d9c022" />
    <SolidColorBrush x:Key="Tier3Brush" Color="#d97a22" />
    <SolidColorBrush x:Key="TierNamedBrush" Color="#c14040" />
    <SolidColorBrush x:Key="TierDotBorderBrush" Color="#1e1508" />
    <SolidColorBrush x:Key="RoleComboBgBrush" Color="#120d05" />
    <SolidColorBrush x:Key="RoleComboBorderBrush" Color="#3a2510" />

    <!-- Task 4 segments: brother card (keeper.css card / bro-developer / perk-plan rules). -->
    <SolidColorBrush x:Key="StatColHeaderBrush" Color="#6a5830" />
    <SolidColorBrush x:Key="IncreaseBtnBgBrush" Color="#2a2a2a" />
    <SolidColorBrush x:Key="IncreaseBtnHoverBrush" Color="#3a3a3a" />
    <SolidColorBrush x:Key="IncreaseBtnBorderBrush" Color="#555555" />
    <SolidColorBrush x:Key="IncreaseBtnFgBrush" Color="#d0d0d0" />
    <SolidColorBrush x:Key="TargetMetBrush" Color="#4caf50" />
    <SolidColorBrush x:Key="TargetPotentialBrush" Color="#d4c532" />
    <SolidColorBrush x:Key="TargetUnmetBrush" Color="#e53935" />
    <SolidColorBrush x:Key="StatColAltBrush" Color="#201610" />
    <!-- .equip-slot-label and .perk-tier-label share keeper.css's #5a4820. -->
    <SolidColorBrush x:Key="EquipSlotLabelBrush" Color="#5a4820" />
    <SolidColorBrush x:Key="PerkOptionalBrush" Color="#3a7ac8" />
    <SolidColorBrush x:Key="PerkPlannedBrush" Color="#3aaa5a" />
    <SolidColorBrush x:Key="PerkBadgeBrush" Color="#6aaa6a" />
    <SolidColorBrush x:Key="ToggleBgBrush" Color="#1e1508" />
</ResourceDictionary>
