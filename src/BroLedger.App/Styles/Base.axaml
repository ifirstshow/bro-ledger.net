<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Translated from JAVARES css/keeper.css, base segments:
         custom window chrome (.app-frame / .modal-frame), .title-bar family,
         .window-btn family, .status-bar family. Remaining segments (toolbar,
         sidebar, list, table, card, modals) are translated per view task.
         Convention: chrome containers are Border, text is TextBlock — compiled XAML
         needs the selector's target type, so CSS class selectors become Border.x / TextBlock.x. -->

    <!-- keeper.css: .app-frame -->
    <Style Selector="Border.app-frame">
        <Setter Property="BorderBrush" Value="{StaticResource BorderAppBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- keeper.css: .modal-frame (applied together with .app-frame on dialogs; declared
         later so it wins at equal specificity, mirroring the CSS source order).
         JavaFX spread is a fraction (0.4 × radius 18 ≈ 7px solid core); Avalonia's is a
         length, so the fraction is folded in here. -->
    <Style Selector="Border.modal-frame">
        <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BoxShadow" Value="0 0 18 7 #66d69f23"/>
    </Style>

    <!-- keeper.css: .title-bar -->
    <Style Selector="Border.title-bar">
        <Setter Property="Background" Value="{StaticResource BgTitleBarBrush}"/>
        <Setter Property="Padding" Value="10,0,0,0"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="MaxHeight" Value="28"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderTitleBarBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <!-- keeper.css: .title-bar-label -->
    <Style Selector="TextBlock.title-bar-label">
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource Cinzel}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- keeper.css: .title-bar-version (left padding 8 + translate-y 1 → margin) -->
    <Style Selector="TextBlock.title-bar-version">
        <Setter Property="Foreground" Value="{StaticResource VersionBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource Cinzel}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Margin" Value="8,1,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- keeper.css: .window-btn. FluentTheme's ControlTheme paints the hover background on
         the template's ContentPresenter, so background overrides must target that part.
         Java's -fx-focus-color/-fx-faint-focus-color transparent is covered by every
         window-btn instance being Focusable=False (no focus ring can appear). -->
    <Style Selector="Button.window-btn">
        <Setter Property="Foreground" Value="{StaticResource WindowBtnBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,4,12,4"/>
        <Setter Property="MinWidth" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button.window-btn /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- keeper.css: .window-btn:hover -->
    <Style Selector="Button.window-btn:pointerover">
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
    </Style>
    <Style Selector="Button.window-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BorderAppBrush}"/>
    </Style>

    <!-- keeper.css: .window-btn-close:hover (later source order wins over .window-btn:hover) -->
    <Style Selector="Button.window-btn-close:pointerover">
        <Setter Property="Foreground" Value="{StaticResource CloseHoverTextBrush}"/>
    </Style>
    <Style Selector="Button.window-btn-close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CloseHoverBgBrush}"/>
    </Style>

    <!-- keeper.css: .status-bar -->
    <Style Selector="Border.status-bar">
        <Setter Property="Background" Value="{StaticResource BgStatusBarBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStatusBarBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
    </Style>

    <!-- keeper.css: .status-label -->
    <Style Selector="TextBlock.status-label">
        <Setter Property="Foreground" Value="{StaticResource StatusTextBrush}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- keeper.css: .status-label.warning -->
    <Style Selector="TextBlock.status-label.warning">
        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
    </Style>

    <!-- ===== Task 2 segments (keeper.css) ===== -->

    <!-- keeper.css: .main-toolbar. Note: the segment's `.main-toolbar .button` sub-rules are
         NOT translated — in the Java main window every toolbar button carries .fancy-btn
         (fancyActionButton/fancyToggle, never a plain Button), so those rules have no live
         target; if a plain button ever lands in the toolbar, add them then. -->
    <Style Selector="Border.main-toolbar">
        <Setter Property="Background" Value="{StaticResource BgToolbarBrush}"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <!-- keeper.css: .watch-status-label -->
    <Style Selector="TextBlock.watch-status-label">
        <Setter Property="Foreground" Value="{StaticResource WatchStatusBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- keeper.css: .scroll-bar (track #120d05; every scrollbar in the app). The Fluent
         geometry (thin auto-hiding overlay bar) is kept — the chunky always-visible JavaFX
         bar with arrow buttons is not reproducible without a full ControlTheme replacement;
         only the palette is ported. Increment/decrement buttons stay Fluent-hidden. -->
    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="{StaticResource FieldBgBrush}"/>
    </Style>
    <!-- keeper.css: .scroll-bar .thumb (#3a2510, radius 3) + :hover (#4d3218) -->
    <Style Selector="ScrollBar Thumb">
        <Setter Property="Background" Value="{StaticResource FieldBorderBrush}"/>
        <Setter Property="CornerRadius" Value="3"/>
    </Style>
    <Style Selector="ScrollBar Thumb:pointerover /template/ Border">
        <Setter Property="Background" Value="#4d3218"/>
    </Style>
    <Style Selector="ScrollBar Thumb:pressed /template/ Border">
        <Setter Property="Background" Value="#4d3218"/>
    </Style>

    <!-- keeper.css: .center-pane (and its .viewport) — both #1a1209 -->
    <Style Selector="ScrollViewer.center-pane">
        <Setter Property="Background" Value="{StaticResource BgAppBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- keeper.css: .fancy-btn. JavaFX paints 4 distinct border sides
         (#6a4a28 #3a2510 #2a1a08 #5a3a18); Avalonia has one BorderBrush per control —
         flattened to the lit top-left value #6a4a28. The 3-pass dropshadow is dropped
         (near-invisible on the dark base). -->
    <Style Selector="Button.fancy-btn">
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="14,5"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.fancy-btn /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{StaticResource FancyBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Background" Value="{StaticResource FancyBgBrush}"/>
    </Style>

    <!-- keeper.css: .fancy-btn:hover -->
    <Style Selector="Button.fancy-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource FancyBgHoverBrush}"/>
    </Style>

    <!-- keeper.css: .fancy-btn:pressed (gradient reversed, border flipped, shadow none —
         the flattened border already matches the pressed top-left value) -->
    <Style Selector="Button.fancy-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource FancyBgPressedBrush}"/>
    </Style>

    <!-- keeper.css: .btn-header / .btn-desc -->
    <Style Selector="TextBlock.btn-header">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
    </Style>
    <Style Selector="TextBlock.btn-desc">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{StaticResource StatusTextBrush}"/>
    </Style>

    <!-- keeper.css: .btn-led + color/lit/muted variants (8x8 rounded dot) -->
    <Style Selector="Border.btn-led">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Border.btn-led.led-red">
        <Setter Property="Background" Value="{StaticResource LedRedBrush}"/>
    </Style>
    <Style Selector="Border.btn-led.led-green">
        <Setter Property="Background" Value="{StaticResource LedGreenBrush}"/>
    </Style>
    <Style Selector="Border.btn-led.led-yellow">
        <Setter Property="Background" Value="{StaticResource LedYellowBrush}"/>
    </Style>
    <Style Selector="Border.btn-led.led-muted">
        <Setter Property="Opacity" Value="0.55"/>
    </Style>
    <!-- keeper.css: .btn-led.led-lit.* (lit color 1.0 + gaussian glow; alpha 0.6 → 0x99,
         spread 0.6 × radius 5 ≈ 3px solid core) -->
    <Style Selector="Border.btn-led.led-lit.led-red">
        <Setter Property="Background" Value="{StaticResource LedRedLitBrush}"/>
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="BoxShadow" Value="0 0 5 3 #99e53935"/>
    </Style>
    <Style Selector="Border.btn-led.led-lit.led-green">
        <Setter Property="Background" Value="{StaticResource LedGreenLitBrush}"/>
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="BoxShadow" Value="0 0 5 3 #9943a047"/>
    </Style>
    <Style Selector="Border.btn-led.led-lit.led-yellow">
        <Setter Property="Background" Value="{StaticResource GoldBrush}"/>
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="BoxShadow" Value="0 0 5 3 #99d69f23"/>
    </Style>

    <!-- keeper.css: .section-header. The -fx-border-width 0 0 1 0 underline is dropped —
         TextBlock renders no border; views needing the line wrap it in a bordered Border. -->
    <Style Selector="TextBlock.section-header">
        <Setter Property="Foreground" Value="{StaticResource SectionHeaderBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="0,0,0,2"/>
    </Style>

    <!-- keeper.css: .card-section (padding-only; any container can carry the class) -->
    <Style Selector="StackPanel.card-section, Grid.card-section">
        <Setter Property="Margin" Value="0,4"/>
    </Style>

    <!-- keeper.css: .field-label / .stat-label / .dim-label -->
    <Style Selector="TextBlock.field-label">
        <Setter Property="Foreground" Value="{StaticResource StatusTextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.stat-label">
        <Setter Property="Foreground" Value="{StaticResource StatusTextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.dim-label">
        <Setter Property="Foreground" Value="{StaticResource StatusTextBrush}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="TextBlock.dim-label.warning">
        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
    </Style>

    <!-- keeper.css: .text-field base (dark amber field for every TextBox). The
         -fx-prompt-text-fill #4a3820 deviation: Avalonia's placeholder color is a theme
         resource, not a styled property — left at theme default. -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{StaticResource FieldBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="4,3"/>
    </Style>
    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{StaticResource FieldFocusBrush}"/>
    </Style>

    <!-- ===== Task 3 segments (keeper.css overview table) ===== -->

    <!-- keeper.css: .overview-root -->
    <Style Selector="Border.overview-root">
        <Setter Property="Background" Value="{StaticResource BgAppBrush}"/>
    </Style>

    <!-- keeper.css: .overview-header -->
    <Style Selector="Border.overview-header">
        <Setter Property="Background" Value="{StaticResource BgOverviewHeaderBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStatusBarBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <!-- keeper.css: .overview-table .column-header (fixed 42px band, 1px right rule) -->
    <Style Selector="Border.overview-header-cell">
        <Setter Property="Background" Value="{StaticResource BgOverviewHeaderBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStatusBarBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="2,3"/>
    </Style>
    <Style Selector="Border.overview-header-cell TextBlock">
        <Setter Property="Foreground" Value="{StaticResource StatusTextBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- keeper.css: .overview-table .column-drag-indicator (header drop position) -->
    <Style Selector="Border.column-drag-indicator">
        <Setter Property="Background" Value="{StaticResource GoldBrush}"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <!-- keeper.css: .overview-table .table-row-cell (56px fixed height, bottom hairline,
         hand cursor). -->
    <Style Selector="Border.overview-row">
        <Setter Property="Background" Value="{StaticResource BgAppBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderOverviewCellBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!-- keeper.css: .table-row-cell:odd -->
    <Style Selector="Border.overview-row.odd">
        <Setter Property="Background" Value="{StaticResource BgOverviewRowAltBrush}"/>
    </Style>
    <!-- keeper.css: .table-row-cell:hover -->
    <Style Selector="Border.overview-row:pointerover">
        <Setter Property="Background" Value="{StaticResource BgOverviewRowHoverBrush}"/>
    </Style>
    <!-- keeper.css: .table-row-cell.drag-target -->
    <Style Selector="Border.overview-row.drag-target">
        <Setter Property="Background" Value="{StaticResource BgOverviewDragTargetBrush}"/>
    </Style>
    <!-- keeper.css: .table-row-cell.frontline-last (2px divider under the frontline group) -->
    <Style Selector="Border.overview-row.frontline-last">
        <Setter Property="BorderBrush" Value="{StaticResource BorderFrontlineDividerBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
    </Style>

    <!-- keeper.css: .overview-table .table-cell (1px vertical rule between cells) -->
    <Style Selector="Border.overview-cell">
        <Setter Property="BorderBrush" Value="{StaticResource BorderOverviewCellBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
    </Style>

    <!-- keeper.css: .cell-name -->
    <Style Selector="TextBlock.cell-name">
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- keeper.css: .overview-title (also .cell-title's 10px italic look) -->
    <Style Selector="TextBlock.overview-title">
        <Setter Property="Foreground" Value="{StaticResource StatusTextBrush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontStyle" Value="Italic"/>
    </Style>

    <!-- keeper.css: .overview-stat-val (-fx-translate-y 1 → render translate, no layout shift) -->
    <Style Selector="TextBlock.overview-stat-val">
        <Setter Property="Foreground" Value="{StaticResource StatValBrush}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="RenderTransform" Value="translate(0px, 1px)"/>
    </Style>

    <!-- keeper.css: .overview-potential-val (raised 4px to hug the stat value baseline) -->
    <Style Selector="TextBlock.overview-potential-val">
        <Setter Property="Foreground" Value="{StaticResource PotentialValBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="RenderTransform" Value="translate(0px, -4px)"/>
    </Style>

    <!-- keeper.css: .overview-expected-val -->
    <Style Selector="TextBlock.overview-expected-val">
        <Setter Property="Foreground" Value="{StaticResource ExpectedValBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <!-- keeper.css: .overview-star-filled / .overview-star-empty -->
    <Style Selector="TextBlock.overview-star-filled">
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
        <Setter Property="FontSize" Value="10"/>
    </Style>
    <Style Selector="TextBlock.overview-star-empty">
        <Setter Property="Foreground" Value="{StaticResource StarEmptyBrush}"/>
        <Setter Property="FontSize" Value="10"/>
    </Style>

    <!-- keeper.css: .weapon-tier-dot (8px circle, bottom-right of the equipment cell) -->
    <Style Selector="Border.weapon-tier-dot">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="BorderBrush" Value="{StaticResource TierDotBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="0,0,2,2"/>
    </Style>
    <Style Selector="Border.weapon-tier-dot.tier-1">
        <Setter Property="Background" Value="{StaticResource Tier1Brush}"/>
    </Style>
    <Style Selector="Border.weapon-tier-dot.tier-2">
        <Setter Property="Background" Value="{StaticResource Tier2Brush}"/>
    </Style>
    <Style Selector="Border.weapon-tier-dot.tier-3">
        <Setter Property="Background" Value="{StaticResource Tier3Brush}"/>
    </Style>
    <Style Selector="Border.weapon-tier-dot.tier-named">
        <Setter Property="Background" Value="{StaticResource TierNamedBrush}"/>
    </Style>

    <!-- keeper.css: .level-allotted-label + state colours -->
    <Style Selector="TextBlock.level-allotted-label">
        <Setter Property="Foreground" Value="{StaticResource AllottedBrush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.level-allotted-label.level-allotted-green">
        <Setter Property="Foreground" Value="{StaticResource AllottedGreenBrush}"/>
    </Style>
    <Style Selector="TextBlock.level-allotted-label.level-allotted-red">
        <Setter Property="Foreground" Value="{StaticResource AllottedRedBrush}"/>
    </Style>

    <!-- keeper.css: .level-pending-badge -->
    <Style Selector="TextBlock.level-pending-badge">
        <Setter Property="Foreground" Value="{StaticResource PendingBadgeBrush}"/>
    </Style>

    <!-- keeper.css: .stat-cell-p1 / .stat-cell-p2 (role priority tint) -->
    <Style Selector="Border.stat-cell-p1">
        <Setter Property="Background" Value="{StaticResource StatCellP1Brush}"/>
    </Style>
    <Style Selector="Border.stat-cell-p2">
        <Setter Property="Background" Value="{StaticResource StatCellP2Brush}"/>
    </Style>

    <!-- keeper.css: .role-combo. FluentTheme paints hover/selection on the template's
         ContentPresenter, so the background override targets that part. -->
    <Style Selector="ComboBox.role-combo">
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="{StaticResource RoleComboBgBrush}"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>
    <Style Selector="ComboBox.role-combo /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{StaticResource RoleComboBorderBrush}"/>
        <Setter Property="Background" Value="{StaticResource RoleComboBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
    </Style>
    <!-- keeper.css: .role-combo .list-cell (dropdown items: gold text on the dark field;
         the generic .list-cell :filled:hover/:selected rules chain on top — #2a1a08 / #3a2510) -->
    <Style Selector="ComboBox.role-combo ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
        <Setter Property="Background" Value="{StaticResource RoleComboBgBrush}"/>
    </Style>
    <Style Selector="ComboBox.role-combo ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BgOverviewRowHoverBrush}"/>
    </Style>
    <Style Selector="ComboBox.role-combo ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BorderStatusBarBrush}"/>
    </Style>

    <!-- ===== Task 4 segments (keeper.css brother card / bro developer / perk plan) ===== -->

    <!-- keeper.css: .brother-card -->
    <Style Selector="Border.brother-card">
        <Setter Property="Background" Value="{StaticResource BgAppBrush}"/>
    </Style>

    <!-- keeper.css: .card-header -->
    <Style Selector="Border.card-header">
        <Setter Property="Background" Value="{StaticResource FieldBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStatusBarBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <Style Selector="TextBlock.card-name">
        <Setter Property="FontFamily" Value="{StaticResource Cinzel}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
    </Style>
    <Style Selector="TextBlock.card-title">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="Foreground" Value="{StaticResource PotentialValBrush}"/>
    </Style>
    <Style Selector="TextBlock.card-background">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource StatusTextBrush}"/>
    </Style>

    <!-- keeper.css: stats-grid column headers -->
    <Style Selector="TextBlock.stat-col-header">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{StaticResource StatColHeaderBrush}"/>
    </Style>

    <!-- keeper.css: .stat-value / .stat-potential / .stat-expected (card grid) -->
    <Style Selector="TextBlock.stat-value">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource StatValBrush}"/>
    </Style>
    <Style Selector="TextBlock.stat-potential">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="Foreground" Value="{StaticResource PotentialValBrush}"/>
    </Style>
    <Style Selector="TextBlock.stat-expected">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="Foreground" Value="{StaticResource ExpectedValBrush}"/>
    </Style>

    <!-- keeper.css: .increase-btn (dark grey square). FluentTheme paints hover/disabled on
         the template's ContentPresenter, so those states target that part. -->
    <Style Selector="Button.increase-btn">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="CornerRadius" Value="3"/>
    </Style>
    <!-- keeper.css: .increase-count -->
    <Style Selector="TextBlock.increase-count">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#aaaaaa"/>
    </Style>
    <Style Selector="Button.increase-btn /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource IncreaseBtnBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource IncreaseBtnBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource IncreaseBtnFgBrush}"/>
    </Style>
    <Style Selector="Button.increase-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource IncreaseBtnHoverBrush}"/>
    </Style>
    <Style Selector="Button.increase-btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0.35"/>
    </Style>

    <!-- keeper.css: .increases-remaining-label + state colours (reuses the overview palette) -->
    <Style Selector="TextBlock.increases-remaining-label">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="Foreground" Value="{StaticResource AllottedBrush}"/>
    </Style>
    <Style Selector="TextBlock.increases-remaining-label.increases-remaining-green">
        <Setter Property="Foreground" Value="{StaticResource AllottedGreenBrush}"/>
    </Style>
    <Style Selector="TextBlock.increases-remaining-label.increases-remaining-red">
        <Setter Property="Foreground" Value="{StaticResource AllottedRedBrush}"/>
    </Style>

    <!-- keeper.css: .stat-target + state colour + priority weight (P1 default bold) -->
    <Style Selector="TextBlock.stat-target">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TargetMetBrush}"/>
    </Style>
    <!-- keeper.css: .stat-target-met (explicit state class; same gold-green as the base) -->
    <Style Selector="TextBlock.stat-target.stat-target-met">
        <Setter Property="Foreground" Value="{StaticResource TargetMetBrush}"/>
    </Style>
    <Style Selector="TextBlock.stat-target.stat-target-p2">
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style Selector="TextBlock.stat-target.stat-target-p3">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="Opacity" Value="0.75"/>
    </Style>
    <Style Selector="TextBlock.stat-target.stat-target-potential">
        <Setter Property="Foreground" Value="{StaticResource TargetPotentialBrush}"/>
    </Style>
    <Style Selector="TextBlock.stat-target.stat-target-unmet">
        <Setter Property="Foreground" Value="{StaticResource TargetUnmetBrush}"/>
    </Style>

    <!-- keeper.css: .stat-col-alt (zebra tint on extra role columns) -->
    <Style Selector="TextBlock.stat-col-alt">
        <Setter Property="Background" Value="{StaticResource StatColAltBrush}"/>
    </Style>
    <Style Selector="StackPanel.stat-col-alt">
        <Setter Property="Background" Value="{StaticResource StatColAltBrush}"/>
    </Style>

    <!-- keeper.css: card-grid stars (slightly larger than the overview's) -->
    <Style Selector="TextBlock.star-filled">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
    </Style>
    <Style Selector="TextBlock.star-empty">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource StarEmptyBrush}"/>
    </Style>

    <!-- keeper.css: .equip-cell / .equip-slot-label -->
    <Style Selector="Border.equip-cell">
        <Setter Property="Background" Value="{StaticResource FieldBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="4"/>
    </Style>
    <Style Selector="TextBlock.equip-slot-label">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{StaticResource EquipSlotLabelBrush}"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <!-- keeper.css: .card-footer / .footer-stat -->
    <Style Selector="Border.card-footer">
        <Setter Property="Background" Value="{StaticResource FieldBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStatusBarBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="8"/>
    </Style>
    <Style Selector="TextBlock.footer-stat">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource StatusTextBrush}"/>
    </Style>

    <!-- keeper.css: .tooltip (dark panel, gold text) -->
    <Style Selector="ToolTip.item-tooltip">
        <Setter Property="Background" Value="#0f0a04"/>
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="6,4"/>
    </Style>

    <!-- keeper.css: .perk-status-circle states (ring around the perk icon) -->
    <Style Selector="Ellipse.perk-status-circle">
        <Setter Property="StrokeThickness" Value="2.5"/>
        <Setter Property="Fill" Value="Transparent"/>
    </Style>
    <Style Selector="Ellipse.perk-status-circle.perk-status-optional">
        <Setter Property="Stroke" Value="{StaticResource PerkOptionalBrush}"/>
    </Style>
    <Style Selector="Ellipse.perk-status-circle.perk-status-planned">
        <Setter Property="Stroke" Value="{StaticResource PerkPlannedBrush}"/>
    </Style>

    <!-- keeper.css: .perk-tier-label / .perk-plan-badge -->
    <Style Selector="TextBlock.perk-tier-label">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{StaticResource EquipSlotLabelBrush}"/>
    </Style>
    <Style Selector="TextBlock.perk-plan-badge">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource PerkBadgeBrush}"/>
    </Style>

    <!-- keeper.css: .overview-potential-toggle (small dark pill; the card reuses it for
         back / clear / reset / auto-assign). FluentTheme needs the template part override. -->
    <Style Selector="Button.overview-potential-toggle">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.overview-potential-toggle /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ToggleBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource StatusTextBrush}"/>
    </Style>
    <Style Selector="Button.overview-potential-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource StatCellP2Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
    </Style>

    <!-- ===== Task 5 segments (keeper.css level-up modal / guide popup / preferences) ===== -->

    <!-- keeper.css: .level-up-frame (declared after .modal-frame so the amber background
         and stronger glow win at equal specificity). Glow alpha 0.45 → 0x73,
         spread 0.45 × radius 24 ≈ 11px solid core. -->
    <Style Selector="Border.level-up-frame">
        <Setter Property="Background" Value="#211608"/>
        <Setter Property="BoxShadow" Value="0 0 24 11 #73d69f23"/>
    </Style>

    <!-- keeper.css: .level-up-title-bar (overrides .title-bar's 28px with a 32px band) -->
    <Style Selector="Border.level-up-title-bar">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#6a3a12" Offset="0"/>
                <GradientStop Color="#3e2008" Offset="1"/>
            </LinearGradientBrush>
        </Setter>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="MaxHeight" Value="32"/>
        <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="Padding" Value="10,0,0,0"/>
    </Style>

    <!-- keeper.css: .level-up-title-label (JavaFX text dropshadow → Effect; gaussian
         rgba(210,160,0,0.7) radius 8 → blur 8, opacity 0.7) -->
    <Style Selector="TextBlock.level-up-title-label">
        <Setter Property="Foreground" Value="#f0c060"/>
        <Setter Property="FontFamily" Value="{StaticResource Cinzel}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Effect">
            <DropShadowEffect BlurRadius="8" Color="#d2a000" Opacity="0.7" OffsetX="0" OffsetY="0"/>
        </Setter>
    </Style>

    <!-- keeper.css: .modal-scroll -->
    <Style Selector="ScrollViewer.modal-scroll">
        <Setter Property="Background" Value="#211608"/>
    </Style>

    <!-- keeper.css: .priority-guide-tooltip (the guide popup's content root; the Java
         VBox's border/background/padding need a Border wrapper in Avalonia) -->
    <Style Selector="Border.priority-guide-tooltip">
        <Setter Property="Background" Value="#0f0a04"/>
        <Setter Property="BorderBrush" Value="#3a2510"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8"/>
    </Style>

    <Style Selector="TextBlock.priority-guide-header">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#dddddd"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style Selector="TextBlock.priority-guide-section">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#aaaaaa"/>
        <Setter Property="Margin" Value="0,4,0,1"/>
    </Style>

    <Style Selector="TextBlock.priority-guide-name">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#dddddd"/>
        <Setter Property="MinWidth" Value="100"/>
    </Style>

    <Style Selector="TextBlock.priority-guide-roll">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#cccccc"/>
        <Setter Property="MinWidth" Value="20"/>
        <Setter Property="TextAlignment" Value="Right"/>
    </Style>

    <Style Selector="TextBlock.priority-guide-dev-pos">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#78c87a"/>
        <Setter Property="MinWidth" Value="42"/>
    </Style>

    <Style Selector="TextBlock.priority-guide-dev-neg">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#e07070"/>
        <Setter Property="MinWidth" Value="42"/>
    </Style>

    <!-- keeper.css: .perk-plan-section / .perk-plan-perk-name -->
    <Style Selector="TextBlock.perk-plan-section">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#aaaaaa"/>
        <Setter Property="Margin" Value="0,6,0,2"/>
    </Style>
    <Style Selector="TextBlock.perk-plan-perk-name">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#dddddd"/>
    </Style>

    <!-- keeper.css: .role-radio (gold radio text; FluentTheme supplies the box) -->
    <Style Selector="RadioButton.role-radio">
        <Setter Property="Foreground" Value="#d69f23"/>
    </Style>

    <!-- keeper.css: .pref-check (gold check text; FluentTheme supplies the box) -->
    <Style Selector="CheckBox.pref-check">
        <Setter Property="Foreground" Value="#d69f23"/>
    </Style>

    <!-- ===== Task 6 segments (keeper.css role-manager / share-import rules) ===== -->

    <!-- keeper.css: .sidebar (role-manager left pane; gold text, transparent list cells) -->
    <Style Selector="Border.sidebar">
        <Setter Property="Background" Value="#120d05"/>
        <Setter Property="BorderBrush" Value="#3a2510"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
    </Style>
    <Style Selector="TextBlock.sidebar-header">
        <Setter Property="Foreground" Value="#ba9238"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Background" Value="#0f0a04"/>
    </Style>

    <!-- keeper.css: .role-editor -->
    <Style Selector="StackPanel.role-editor, DockPanel.role-editor">
        <Setter Property="Background" Value="#1a1209"/>
    </Style>

    <!-- keeper.css: .role-list-buttons -->
    <Style Selector="Border.role-list-buttons">
        <Setter Property="Background" Value="#0f0a04"/>
        <Setter Property="BorderBrush" Value="#3a2510"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
    </Style>

    <!-- keeper.css: .prio-toggle (P1/P2/P3 weight previews; selected = darker amber) -->
    <Style Selector="ToggleButton.prio-toggle">
        <Setter Property="Background" Value="#1e1508"/>
        <Setter Property="Foreground" Value="#8a7040"/>
        <Setter Property="BorderBrush" Value="#3a2510"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="4,2"/>
    </Style>
    <Style Selector="ToggleButton.prio-toggle /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{Binding $parent[ToggleButton].Foreground}"/>
    </Style>
    <Style Selector="ToggleButton.prio-toggle:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#3a2510"/>
        <Setter Property="Foreground" Value="#d69f23"/>
    </Style>
    <Style Selector="ToggleButton.prio-toggle:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

    <!-- keeper.css: .pack-title (import dialog's fetched-pack title) -->
    <Style Selector="TextBlock.pack-title">
        <Setter Property="Foreground" Value="#d4b060"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- keeper.css: .check-box (gold check text; FluentTheme supplies the box) -->
    <Style Selector="CheckBox.check-box">
        <Setter Property="Foreground" Value="#d69f23"/>
    </Style>

    <!-- keeper.css: .list-view / .list-cell (transparent list, gold rows, amber selection) -->
    <Style Selector="ListBox.role-list">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.role-list ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#d69f23"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBox.role-list ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextBlock.Foreground" Value="{Binding $parent[ListBoxItem].Foreground}"/>
    </Style>
    <Style Selector="ListBox.role-list ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2a1a08"/>
    </Style>
    <Style Selector="ListBox.role-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#3a2510"/>
    </Style>
    <Style Selector="ListBox.role-list ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#4d3218"/>
    </Style>
</Styles>
