<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>BroLedger.App</RootNamespace>
    <PublishAot>true</PublishAot>
    <ApplicationIcon>Assets\BroLedger.ico</ApplicationIcon>
    <!-- AOT 发布必然 self-contained，而引用的 Tools 项目是框架依赖 Exe（仅当库用：
         BrotherCsvExporter/BrotherSavefileExporter）。关掉 SDK 的 exe→exe 自包含一致性
         检查（NETSDK1150，learn.microsoft.com/dotnet/core/compatibility/sdk/5.0/referencing-executable）。 -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <!-- ponytail: 产物形态是自包含目录（exe + Avalonia 原生库同目录）——Native AOT 不支持把
         Avalonia 原生库嵌入单 exe（IncludeNativeLibrariesForSelfExtract 在 AOT 下被忽略，已实测）。
         分发须整目录（CI 已按目录打包）；只复制 exe 会从 DLL 搜索路径加载到不兼容旧库而闪退。 -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BroLedger.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BroLedger.Core\BroLedger.Core.csproj" />
    <!-- Java ui→tools 1:1: toolbar Export/Excerpt buttons call the exporters (ui/MainController
         depends on tools/BrotherCsvExporter + BrotherSavefileExporter). -->
    <ProjectReference Include="..\BroLedger.Tools\BroLedger.Tools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
