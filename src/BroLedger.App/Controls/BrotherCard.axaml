<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BroLedger.App.Controls.BrotherCard">
    <!-- Port of JAVA/fxml/brother-card.fxml: the stats grid, perk grid and equipment pane
         are populated programmatically (buildStatRows / PerkPlanPane / buildEquipmentPane). -->
    <Border Classes="brother-card">
        <StackPanel Spacing="14" Margin="16,14,16,16">

            <!-- 0. Navigation toolbar -->
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BackBtn" Content="← 返回" Classes="overview-potential-toggle"/>
            </StackPanel>

            <!-- 1. Header: portrait + name / title / background -->
            <Border Classes="card-header">
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Image x:Name="PortraitView" Width="96" Height="96" Stretch="Uniform"/>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="NameLabel" Classes="card-name"/>
                        <TextBlock x:Name="TitleLabel" Classes="card-title"/>
                        <TextBlock x:Name="BackgroundLabel" Classes="card-background"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 2. Traits -->
            <StackPanel Classes="card-section" Spacing="6">
                <TextBlock Text="特性" Classes="section-header"/>
                <WrapPanel x:Name="TraitsHost"/>
            </StackPanel>

            <!-- 3. Role -->
            <!-- Java 行 3：Clear 靠左，Reset/Show All/Frontline/Backline 经 hgrow Region 推到右侧 -->
            <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="角色：" Classes="field-label" VerticalAlignment="Center"/>
                    <ComboBox x:Name="RoleCombo" Classes="role-combo" MaxWidth="300"
                              HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <Button x:Name="ClearRoleBtn" Content="清除" Classes="overview-potential-toggle"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right">
                    <Button x:Name="ResetRolesBtn" Content="重置" Classes="overview-potential-toggle"/>
                    <Button x:Name="ShowAllRolesBtn" Content="显示全部" Classes="overview-potential-toggle"/>
                    <Button x:Name="FrontlineRolesBtn" Content="前排" Classes="overview-potential-toggle"/>
                    <Button x:Name="BacklineRolesBtn" Content="后排" Classes="overview-potential-toggle"/>
                </StackPanel>
            </Grid>

            <!-- 4. Stats grid (populated programmatically) -->
            <StackPanel Classes="card-section" Spacing="6">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="属性" Classes="section-header"/>
                    <Button Grid.Column="1" x:Name="AutoAssignBtn" Content="按角色自动分配"
                            Classes="overview-potential-toggle" HorizontalAlignment="Right"/>
                </Grid>
                <Grid x:Name="StatsGrid"/>
            </StackPanel>

            <!-- 5. Perks (populated programmatically) -->
            <StackPanel Classes="card-section" Spacing="6">
                <Grid ColumnDefinitions="Auto,*">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="天赋" Classes="section-header"/>
                        <TextBlock x:Name="PerkPointsLabel" Classes="level-pending-badge" IsVisible="False"/>
                        <TextBlock x:Name="PerkPlanBadgeLabel" Classes="perk-plan-badge" IsVisible="False"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right">
                        <Button x:Name="ClearPlanBtn" Content="清除" Classes="overview-potential-toggle"
                                IsVisible="False"/>
                        <Button x:Name="InitPlanBtn" Classes="overview-potential-toggle" IsVisible="False"/>
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="PerkPlanHost"/>
            </StackPanel>

            <!-- 6. Equipment (populated programmatically) -->
            <StackPanel Classes="card-section" Spacing="6">
                <TextBlock Text="装备" Classes="section-header"/>
                <StackPanel x:Name="EquipmentHost" Orientation="Horizontal" Spacing="10"/>
            </StackPanel>

            <!-- 7. Footer: derived stats -->
            <Border Classes="card-footer">
                <StackPanel Orientation="Horizontal" Spacing="24">
                    <TextBlock x:Name="ArmorLabel" Classes="footer-stat"/>
                    <TextBlock x:Name="FatigueLabel" Classes="footer-stat"/>
                    <TextBlock x:Name="DamageLabel" Classes="footer-stat"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</UserControl>
