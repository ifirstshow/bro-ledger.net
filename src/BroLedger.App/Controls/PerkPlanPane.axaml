             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BroLedger.App.Controls.PerkPlanPane">
    <!-- Java PerkPlanPane: one HBox row per perk tier, slots built in code (build()). -->
