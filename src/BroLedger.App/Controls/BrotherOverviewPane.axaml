<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BroLedger.App.Controls.BrotherOverviewPane">
    <!-- Java BrotherOverviewPane: a TableView whose sticky header shares column widths with
         the body. The Avalonia port is a custom two-ScrollViewer layout (header border +
         synced body) — see the code-behind header comment for the DataGrid trade-off. -->
    <Border x:Name="Root" Classes="overview-root">
        <DockPanel>
            <Border Classes="overview-header" DockPanel.Dock="Top">
                <ScrollViewer x:Name="HeaderScroll" VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="HeaderHost" Orientation="Horizontal"/>
                </ScrollViewer>
            </Border>
            <ScrollViewer x:Name="BodyScroll" Padding="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="RowsHost" DragDrop.AllowDrop="True"/>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
