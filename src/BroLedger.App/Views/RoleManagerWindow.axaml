<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BroLedger.App.ViewModels"
        x:Class="BroLedger.App.RoleManagerWindow"
        x:DataType="vm:RoleManagerViewModel"
        Title="Manage Roles"
        Width="960" Height="620" MinWidth="960" MinHeight="620"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Background="{StaticResource BgAppBrush}">

    <!-- role-manager.fxml 1:1: app-frame with custom title bar, role-list sidebar
         (add/delete/order/share/import buttons) and the name/position/attributes editor.
         The 8-row attribute grid is built in code (Java buildStatEditorGrid). -->
    <Border Classes="app-frame modal-frame"
            Background="{StaticResource BgAppBrush}"
            TextElement.Foreground="{StaticResource GoldBrush}"
            TextElement.FontSize="13">
        <DockPanel>

            <Border x:Name="TitleBar" Classes="title-bar" DockPanel.Dock="Top">
                <DockPanel LastChildFill="True">
                    <TextBlock Classes="title-bar-label" Text="Manage Roles"
                               VerticalAlignment="Center"/>
                    <Button Classes="window-btn window-btn-close" Content="✕"
                            Focusable="False" DockPanel.Dock="Right" Click="OnClose"/>
                </DockPanel>
            </Border>

            <Grid ColumnDefinitions="200,*">

                <!-- Left: role list -->
                <Border Classes="sidebar" Grid.Column="0">
                    <DockPanel>
                        <TextBlock Classes="sidebar-header" Text="Roles" DockPanel.Dock="Top"/>
                        <Border Classes="role-list-buttons" DockPanel.Dock="Bottom">
                            <StackPanel Spacing="6" Margin="8">
                                <Grid ColumnDefinitions="*,6,*">
                                    <Button Classes="fancy-btn" Content="+ Add" Focusable="False" Click="OnAdd"/>
                                    <Button Grid.Column="2" Classes="fancy-btn" Content="− Delete" Focusable="False" Click="OnDelete"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,6,*">
                                    <Button Classes="fancy-btn" Content="▲" MinWidth="36" Focusable="False" Click="OnMoveUp"/>
                                    <Button Grid.Column="2" Classes="fancy-btn" Content="▼" MinWidth="36" Focusable="False" Click="OnMoveDown"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,6,*">
                                    <Button Classes="fancy-btn" Content="Share…" Focusable="False" Click="OnShare"/>
                                    <Button Grid.Column="2" Classes="fancy-btn" Content="Import…" Focusable="False" Click="OnImport"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <ListBox x:Name="RoleList" Classes="role-list"
                                 ItemsSource="{Binding Roles}"/>
                    </DockPanel>
                </Border>

                <!-- Right: edit form -->
                <DockPanel x:Name="Editor" Grid.Column="1" Classes="role-editor" LastChildFill="True"
                           Margin="20,16">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Classes="fancy-btn" Content="Save Role" Focusable="False" Click="OnSave"/>
                        <Button Classes="fancy-btn" Content="Close" Focusable="False" Click="OnClose"/>
                    </StackPanel>

                    <Grid RowDefinitions="Auto,Auto,Auto,*">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="field-label" Text="Name:" MinWidth="80" VerticalAlignment="Center"/>
                            <TextBox x:Name="NameField" PlaceholderText="Role name" HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Margin="0,14,0,0">
                            <TextBlock Classes="field-label" Text="Position:" MinWidth="80" VerticalAlignment="Center"/>
                            <RadioButton x:Name="FrontlineRadio" Classes="role-radio" GroupName="position"
                                         Content="Frontline"/>
                            <RadioButton x:Name="BacklineRadio" Classes="role-radio" GroupName="position"
                                         Content="Backline"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Classes="card-section" Spacing="6" Margin="0,14">
                            <TextBlock Classes="section-header" Text="Attributes"/>
                            <Grid x:Name="StatEditorGrid" ColumnDefinitions="120,60,Auto" RowDefinitions="Auto"/>
                        </StackPanel>

                        <!-- Perk Plan (populated programmatically) -->
                        <Grid Grid.Row="3" Classes="card-section" RowDefinitions="Auto,*" Margin="0,14,0,0">
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="section-header" Text="Perk Plan"/>
                                <TextBlock x:Name="PerkPlanBadge" Classes="perk-plan-badge" IsVisible="False"/>
                            </StackPanel>
                            <ScrollViewer x:Name="PerkPlanScroll" Grid.Row="1" Classes="modal-scroll"
                                          HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0"/>
                        </Grid>
                    </Grid>
                </DockPanel>

            </Grid>
        </DockPanel>
    </Border>
</Window>
