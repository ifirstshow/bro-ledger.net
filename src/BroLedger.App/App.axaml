<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BroLedger.App.App"
             RequestedThemeVariant="Dark">
    <!-- keeper.css is a fully custom dark theme; FluentTheme supplies the default control
         templates underneath (chosen over SimpleTheme: maintained default, dark variant,
         DataGrid themes included). -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Styles/Base.axaml" />
    </Application.Styles>
</Application>
